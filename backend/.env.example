# ==============================================================================
# MARKETLINK BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

SECRET_KEY=django-insecure-marketlink-secret-key-techwiz-2026-very-secure
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*

# --- Database Configuration (MySQL 8.x Community Server - InnoDB) ---
DB_NAME=marketlink_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=0

# --- Redis & Cache Configuration ---
USE_REDIS=False
REDIS_URL=redis://127.0.0.1:6379/0

# --- CORS & Security ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email Service (Console backend for local test, Gmail SMTP for demo) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MarketLink <no-reply@marketlink.vn>

# --- Realtime WebSocket Ticket ---
WS_TICKET_TTL=30

# --- Gemini AI Chatbot API ---
GEMINI_API_KEY=
AI_CHAT_ENABLED=True
