# Copy to backend/.env and fill in real values. Never commit the .env itself.
SECRET_KEY=django-insecure-change-this-before-deploying
DEBUG=True
ALLOWED_HOSTS=*

# Required: MySQL 8 database created with utf8mb4 / utf8mb4_0900_ai_ci.
# The same user needs rights on test_<DB_NAME> for pytest.
DB_NAME=techwiz_db
DB_USER=techwiz_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Seconds to keep a DB connection open; keep below MySQL's wait_timeout. 0 = per request.
DB_CONN_MAX_AGE=0

# Set USE_REDIS=True once a Redis server is reachable. While it is False the project
# falls back to in-process cache and channel layer, which is single-worker only.
USE_REDIS=False
REDIS_URL=redis://127.0.0.1:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@prj-techwiz.local

WS_TICKET_TTL=30
